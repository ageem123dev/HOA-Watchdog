# Dependencies
node_modules/

# Next.js build output
.next/
out/
next-env.d.ts

# Test and type-check output
coverage/
*.tsbuildinfo

# Local secrets — never committed (see NFR-2 / AD-2).
# Every .env variant Next.js loads, not just .env and .env*.local: .env.production,
# .env.development and .env.test are loaded the same way and carry the same risk.
# .env.example is the deliberate exception — it holds names, never values.
.env
.env.*
!.env.example

# Local diagnostic scratch — throwaway probes written while debugging, never product code.
# Also excluded from eslint and vitest: left in the working tree these are collected by
# both, which turns a green gate red for reasons that have nothing to do with the product.
.probe/
envprobe

# OS noise
.DS_Store
Thumbs.db

# Python bytecode. A probe script generated this and `git add -A` swept it in.
__pycache__/
*.pyc

# Argus agent state: run records + learned lessons, machine-local
.argus/
