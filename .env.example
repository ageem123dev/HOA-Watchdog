# Names only — never real values. This is the one .env* file .gitignore does not
# ignore, and core/security/nfr2-guard.test.ts reads it on every test run.
#
# Copy to .env.local and fill in. The application builds and tests without these;
# it cannot sign anyone in or store a document without them.

# Postgres (Railway). Two roles, per AD-4: the writer is used by ingestion and
# sign-in; the reader is SELECT-only and is the only role catalog queries use.
WATCHDOG_WRITER_DATABASE_URL=
WATCHDOG_READER_DATABASE_URL=

# Auth.js session signing key. Generate with: npx auth secret
AUTH_SECRET=

# S3-compatible object storage for document bytes (AD-16).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional, and only read by scripts/verify-storage.mjs. Name a bucket that
# exists in this account but sits outside the token's scope, and the script will
# assert the token is genuinely refused (403) rather than merely unable to find
# it (404). Unset, that check reports SKIP — it cannot tell a scoped token from
# an unscoped one pointed at a bucket that does not exist.
R2_OUT_OF_SCOPE_BUCKET=
