# Names only — never real values. This is the one .env* file .gitignore does not
# ignore, and core/security/nfr2-guard.test.ts reads it on every test run.
#
# Copy to .env.local and fill in from the Supabase project's API settings.
# The application builds without these; it cannot sign anyone in without them.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
